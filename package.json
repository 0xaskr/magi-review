{
  "name": "@local/dsh-magi-review",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "MAGI council review: independent briefs, anonymous discussion, sealed ballots and rule-based verdicts for DeepSeek Harness.",
  "exports": {
    ".": "./lib/index.js",
    "./restrict": "./lib/restrict.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "docs"],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0",
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-subagent": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-workspace-changes": "^0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-default-model": { "optional": true },
    "@deepseek-ai/dsh-session-projection": { "optional": true },
    "@deepseek-ai/dsh-tool-subagent": { "optional": true },
    "@deepseek-ai/dsh-working-directory": { "optional": true },
    "@deepseek-ai/dsh-workspace-changes": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-chat"] }
  }
}
